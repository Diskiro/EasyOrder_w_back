# ========================================================
# EasyOrder - Plantilla de Variables de Entorno (.env.example)
# Copia este archivo como .env y rellena tus credenciales reales
# ========================================================

# Token de Cloudflare Tunnel
TUNNEL_TOKEN=tu_token_de_cloudflare_tunnel_aqui

# Configuración Base de Datos Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_segura
POSTGRES_DB=postgres

# Configuración Backend
PORT=3000
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_segura
DB_NAME=postgres
JWT_SECRET=tu_jwt_secret_largo_y_seguro
CORS_ORIGIN=http://localhost,http://127.0.0.1,https://useeasyorder.com,https://api.useeasyorder.com

# Configuración Frontend
VITE_API_URL=https://api.useeasyorder.com/api
